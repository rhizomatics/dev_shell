// Throwaway Home Assistant for developing homeassistant-repl: HA runs from pip inside this container,
// with custom_components/ha_repl_server symlinked into dev/config. Start it with: dev/run-ha.sh
{
  "name": "ha-repl dev (Home Assistant)",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",
  "forwardPorts": [8123],
  "portsAttributes": { "8123": { "label": "Home Assistant" } },
  "containerEnv": {
    // Keep the container's virtualenvs off the bind-mounted workspace, so they
    // don't clobber the host's macOS .venv.
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv-hass-shell",
    "HA_VENV": "/home/vscode/.venv-ha"
  },
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "mounts": [
    "source=ha-repl-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && dev/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff","anthropic.claude-code"]
    }
  }
}

